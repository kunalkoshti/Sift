VITE_API_URL=http://localhost:8001
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the Supabase publishable key (called the anon key in older projects).
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
# Comma-separated email allowlist for displaying the private metrics page.
# The backend ADMIN_EMAILS/ADMIN_USER_IDS allowlist remains authoritative.
VITE_ADMIN_EMAILS=your-admin-email@example.com
VITE_ADMIN_USER_IDS=
