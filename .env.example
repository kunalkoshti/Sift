# Redis connection and stream settings
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM=sift-logs
# Approximate maximum number of entries retained in the Redis stream.
REDIS_STREAM_MAXLEN=10000

# Redis consumer-group settings
REDIS_GROUP=sift-log-consumers
REDIS_CONSUMER=consumer-1
REDIS_READ_COUNT=100
REDIS_BLOCK_MS=5000
REDIS_GROUP_START_ID=0
CONSUMER_RUN_ONCE=false

# Postgres connection
POSTGRES_DSN=postgresql://sift:sift@localhost:5433/sift
# Keep the pool small for Supabase session-mode pooling and Cloud Run rollouts.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=3

# Embedding and chunking settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_WINDOW_SECONDS=60
EMBED_BATCH_SIZE=32
MAX_RECORDS_PER_CHUNK=25

# Embedder execution mode. The regular service defaults to one-shot batch mode;
# log-embedder-live always uses live polling mode.
EMBEDDER_MODE=batch
EMBEDDER_POLL_SECONDS=10
EMBEDDER_WORKER_NAME=embedder-1
EMBEDDER_RUN_ONCE=false

# Log generator timing settings
GENERATOR_NOISE_START_SECONDS=-180
GENERATOR_NOISE_END_SECONDS=120
GENERATOR_BASE_TIMESTAMP=2026-01-01T00:00:00+00:00

# Retrieval and LLM settings
RETRIEVAL_TOP_K=5
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATE_K=20
# Candidate pool used to discover competing traces before final top-k context.
TRACE_CANDIDATE_K=40
RRF_K=60
DENSE_RRF_WEIGHT=1.0
LEXICAL_RRF_WEIGHT=1.0
# Trace score thresholds are model-score-specific; reranker scores and cosine
# similarities do not share a common numeric scale.
TRACE_RERANK_SCORE_GAP=1.0
TRACE_COSINE_SCORE_GAP=0.05
# Maximum chunks returned by direct time-window retrieval.
TEMPORAL_TOP_K=10
# Maximum chunks retained per expanded trace before prompt formatting.
MAX_TRACE_CHUNKS=50
# Hard character limit for the LLM context sent by log-api.
MAX_CONTEXT_CHARS=50000
# Gate 1 self-RAG confidence check. Use shadow while calibrating; enforce
# returns a deterministic abstention for weak dense evidence with no trace.
SELFRAG_CONFIDENCE_GATE_MODE=shadow
SELFRAG_MIN_DENSE_SIMILARITY=0.55
# Gate 2 post-generation evidence verification. Keep shadow while calibrating.
SELFRAG_EVIDENCE_GATE_MODE=shadow
# Optional model override; blank uses LLM_MODEL.
SELFRAG_EVIDENCE_MODEL=
SELFRAG_EVIDENCE_MAX_UNSUPPORTED_CLAIMS=0
SELFRAG_EVIDENCE_MAX_RETRIES=1
# Gate 3 deterministic scope/answerability check. Keep shadow while validating.
SELFRAG_SCOPE_GATE_MODE=shadow
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
# Evaluation LLM settings. These are independent from the log-api LLM above.
# Change EVAL_MODEL to switch the classifier and RAGAS judge model.
EVAL_PROVIDER=cerebras
EVAL_MODEL=gemma-4-31b
EVAL_BASE_URL=https://api.cerebras.ai/v1
EVAL_API_KEY=
# Optional model override for behavior classification.
EVAL_CLASSIFIER_MODEL=
# Leave blank unless the selected provider explicitly supports this option.
EVAL_REASONING_EFFORT=
# Maximum output tokens allowed for each RAGAS judge response.
RAGAS_MAX_TOKENS=4096
# Legacy fallback for older evaluation configuration; prefer EVAL_CLASSIFIER_MODEL.
BEHAVIOR_CLASSIFIER_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=

# Application logging
LOG_LEVEL=INFO

# Browser origins allowed to call log-api. Use a comma-separated list in
# deployment, for example: https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Supabase Auth. Keep AUTH_REQUIRED=false for local unauthenticated API work;
# set it to true in Cloud Run. The API verifies Supabase access tokens using
# the JWKS URL (preferred). SUPABASE_JWT_SECRET is only for legacy HS256 keys
# and should be stored as a deployment secret, never committed.
AUTH_REQUIRED=false
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=

# HTTP protection. Redis-backed state is shared across Cloud Run instances and
# is keyed by the verified Supabase user when auth is enabled, otherwise by IP.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_RATE_LIMIT_PREFIX=sift:ratelimit
METRICS_REDIS_PREFIX=sift:metrics
METRICS_RETENTION_SECONDS=604800
ADMIN_METRICS_WINDOW_MINUTES=1440
# Comma-separated Supabase emails and/or user IDs allowed to view /admin/metrics.
ADMIN_EMAILS=
ADMIN_USER_IDS=
# Maximum request body size accepted by log-api, in bytes.
MAX_REQUEST_BYTES=16384

# Cloud deployment and live-pipeline CLI settings.
# Keep credentials in GitHub Actions secrets or your untracked local .env.
GCP_PROJECT_ID=sift-512502
GCP_REGION=us-east1
ARTIFACT_REPOSITORY=sift
LOG_API_SERVICE=sift-log-api
VERCEL_FRONTEND_URL=https://your-production-domain.vercel.app
LOG_API_URL=
COLLECTOR_URL=

# Optional DSN used by local psql verification commands. Do not commit a
# password here; the running application uses POSTGRES_DSN above.
SUPABASE_DSN=

# GitHub Actions-only values; configure these in repository variables/secrets.
# GCP_SERVICE_ACCOUNT=github-deployer@sift-512502.iam.gserviceaccount.com
# GCP_WORKLOAD_IDENTITY_PROVIDER=projects/.../locations/global/workloadIdentityPools/.../providers/...
# The live-worker deployment workflow reads these two as GitHub Actions secrets.
# LIVE_REDIS_URL=rediss://default:...@...:6379
# LIVE_POSTGRES_DSN=postgresql://postgres...?...sslmode=require
# VERCEL_ORG_ID=...
# VERCEL_PROJECT_ID=...
# VERCEL_TOKEN=...
